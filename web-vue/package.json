{
  "name": "scenic-guide-vue",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "vue-tsc -b --pretty false",
    "check:encoding": "node ../scripts/check-encoding.mjs",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@vueuse/core": "^14.3.0",
    "dompurify": "^3.4.9",
    "echarts": "^6.1.0",
    "marked": "^18.0.5",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "vue": "^3.5.24",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vue-tsc": "^3.1.5"
  },
  "overrides": {
    "gh-pages": "6.3.0"
  }
