# Scenic Guide - 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# NEVER commit .env with real credentials.

# AI 服务 (必填)
SCENIC_GUIDE_AI_API_KEY=your-dashscope-api-key

# Embedding 服务 (必填，可与 AI 共用同一 key)
SCENIC_GUIDE_EMBEDDING_API_KEY=your-dashscope-api-key

# 多模态服务（默认关闭；启用后必须配置 API Key）
# SCENIC_GUIDE_MULTIMODAL_ENABLED=false
# SCENIC_GUIDE_MULTIMODAL_PROVIDER=qwen
# SCENIC_GUIDE_MULTIMODAL_MODEL=qwen3.5-omni-plus
# SCENIC_GUIDE_MULTIMODAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SCENIC_GUIDE_MULTIMODAL_API_KEY=your-multimodal-api-key
# SCENIC_GUIDE_MULTIMODAL_TIMEOUT_SECONDS=60

# 高德 Web 服务坐标校准（仅校准命令使用，不进入前端构建）
AMAP_API_KEY=your-amap-web-service-key
# AMAP_SECURITY_CODE=your-amap-security-code

# JWT 安全密钥（必填；仅接受 64 个 hex 字符，或 base64 解码后至少 32 bytes）
# 跨平台生成 64 hex: openssl rand -hex 32
# PowerShell 生成 64 hex: $rng=[Security.Cryptography.RandomNumberGenerator]::Create(); $bytes=[byte[]]::new(32); $rng.GetBytes($bytes); $rng.Dispose(); ($bytes | ForEach-Object { $_.ToString('x2') }) -join ''
SCENIC_GUIDE_SECURITY_JWT_SECRET=

# 可选配置
# SCENIC_GUIDE_SERVER_PORT=8080
# SCENIC_GUIDE_LOGGING_LEVEL=info
# SCENIC_GUIDE_SECURITY_TOKEN_EXPIRE_HOURS=24
# SCENIC_GUIDE_SECURITY_ALLOWED_ORIGINS=https://your-domain.com
# 生产环境位于反向代理后时必须填写实际代理 IP/CIDR（逗号分隔）；未配置时不信任 X-Forwarded-For。
# 非法 IP/CIDR 会导致启动失败；当前程序不会因“生产环境未配置”而主动失败。
# SCENIC_GUIDE_TRUSTED_PROXIES=<reverse-proxy-ip>,<reverse-proxy-cidr>
# SCENIC_GUIDE_REDIS_ADDR=localhost:6379
# SCENIC_GUIDE_REDIS_PASSWORD=
